rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /articles/{articleSlug}/likes/{userId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['createdAt']);
      allow delete: if request.auth != null && request.auth.uid == userId;
      allow update: if false;
    }

    match /articles/{articleSlug}/comments/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'body', 'createdAt']);
      allow update: if false;
      allow delete: if request.auth != null
        && resource.data.authorId == request.auth.uid;
    }
  }
}
